# Copy this file to .env and fill in the values. Never commit .env.

# Local PostgreSQL in Docker (see compose.yaml)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=

# Connection string for the app: postgresql://USER:PASSWORD@localhost:PORT/DB
DATABASE_URL=

# Server (/srv/lockcrm/.env, mode 600): the same keys without POSTGRES_PORT,
# and the database host in DATABASE_URL is "db": postgresql://USER:PASSWORD@db:5432/DB
# Login. BETTER_AUTH_SECRET: a random string of 32+ characters (openssl rand -base64 32)
BETTER_AUTH_SECRET=
# Address of the app: http://localhost:3000 locally
BETTER_AUTH_URL=
# Where login emails go: Mailpit locally (smtp://127.0.0.1:1025), Resend on the server
SMTP_URL=
# Sender address of the login emails
MAIL_FROM=
# Email of the owner. Needed only to move existing data to the owner (the migration) and for db:seed
OWNER_EMAIL=
# Mailpit web address, read by the tests (default http://127.0.0.1:8025)
MAILPIT_URL=
